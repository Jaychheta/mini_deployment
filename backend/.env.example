# ─── Application ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL — running directly on Windows) ──────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DO NOT put the real password here — keep it only in .env (which is gitignored)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/mini_deploy

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set the callback URL to: http://localhost:3001/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=change-this-to-a-32-byte-secret-key-in-production
GITHUB_WEBHOOK_SECRET=change-this-to-a-long-random-secret-in-production
WEBHOOK_BASE_URL=http://localhost:3001

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Phase 4: Docker Deployment ───────────────────────────────────────────────
# Workspace directory — each deployment gets its own subdirectory
DEPLOY_WORKSPACE=D:\mini-deploy-platform\deployments

# Host port range assigned to deployed containers (5000–5999 default)
DEPLOY_PORT_MIN=5000
DEPLOY_PORT_MAX=5999

# Health check configuration
HEALTH_CHECK_ATTEMPTS=10
HEALTH_CHECK_INTERVAL_MS=3000
HEALTH_CHECK_TIMEOUT_MS=5000

# ─── Phase 6: Nginx Reverse Proxy & Domain Configuration ─────────────────────
DEPLOYMENT_DOMAIN=localhost
PUBLIC_PROTOCOL=http
NGINX_ENABLED=true
NGINX_CONFIG_DIR=D:\mini-deploy-platform\nginx\generated
NGINX_BIN_PATH=nginx

# ─── Phase 7: Resource Monitoring & Cost Dashboard ───────────────────────────
RESOURCE_MONITOR_ENABLED=true
RESOURCE_SAMPLE_INTERVAL_MS=10000
RESOURCE_RETENTION_DAYS=7
COST_ESTIMATE_ENABLED=true
ESTIMATED_MONTHLY_DEPLOYMENT_COST=5.00
ESTIMATED_CPU_HOURLY_RATE=0.005
ESTIMATED_RAM_GB_HOURLY_RATE=0.005


